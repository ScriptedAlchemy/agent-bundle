{
  "schemaVersion": 1,
  "host": "claude",
  "minimumVersion": "2.1.232",
  "authentication": {
    "mode": "existing-subscription-session",
    "removedEnvironmentSuffix": "_API_KEY"
  },
  "command": {
    "args": [
      "-p",
      "--plugin-dir",
      "<plugin-root>",
      "--output-format",
      "stream-json",
      "--verbose",
      "--include-hook-events",
      "--no-session-persistence",
      "<task-input>"
    ],
    "forbiddenArgs": ["--bare"]
  },
  "evidence": {
    "activation": "observed-only-for-Skill-tool-use",
    "captures": ["envelopes", "plugins", "errors", "mcp", "hooks", "usage"],
    "rawLogs": "never-retained"
  }
}
