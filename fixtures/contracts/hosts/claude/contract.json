{
  "schemaVersion": 1,
  "host": "claude",
  "executable": "claude",
  "minimumVersion": "2.1.232",
  "probes": {
    "version": ["--version"],
    "help": ["--help"],
    "status": ["plugin", "--help"]
  },
  "requiredHelpTerms": [
    "--plugin-dir",
    "--output-format",
    "stream-json",
    "--no-session-persistence"
  ],
  "commandShapes": {
    "nativeExecution": [
      "-p",
      "--plugin-dir",
      "<plugin-root>",
      "--output-format",
      "stream-json",
      "--no-session-persistence",
      "<task-input>"
    ],
    "hookEvent": ["hook_event_name", "PreToolUse"]
  },
  "eventEnvelopeFiles": ["stream-events.jsonl", "hook-event.json"]
}
