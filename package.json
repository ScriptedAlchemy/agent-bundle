{
  "name": "agent-bundle-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "rslib build",
    "test": "rstest --config rstest.config.ts",
    "test:watch": "rstest --config rstest.config.ts --watch",
    "lint": "rslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm test && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@rslib/core": "0.23.2",
    "@rslint/core": "0.8.0",
    "@rstest/adapter-rslib": "0.11.8",
    "@rstest/core": "0.11.8",
    "@types/node": "26.2.0",
    "commander": "15.0.0",
    "typescript": "7.0.2"
  }
}
