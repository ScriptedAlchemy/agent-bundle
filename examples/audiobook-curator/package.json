{
  "name": "@agent-bundle-example/audiobook-curator",
  "version": "1.0.0",
  "private": true,
  "description": "A complete RSC-authored Claude and Codex audiobook-curation plugin, CLI, Skill, and MCP server.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "audiobook-curator": "./dist/bin/audiobook-curator.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "agent-bundle build --json --output artifact",
    "check": "pnpm validate && pnpm build && pnpm typecheck && pnpm test",
    "dev": "agent-bundle dev",
    "test": "rstest tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "agent-bundle validate --json"
  },
  "dependencies": {
    "@agent-bundle/rsc-runtime": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "react": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@rstest/core": "0.11.10",
    "@types/react": "19.2.18",
    "agent-bundle": "workspace:*"
  }
}
