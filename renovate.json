{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "repos/**"
  ],
  "packageRules": [
    {
      "description": "Keep Effect runtime upgrades in the coordinated release and subtree chore.",
      "matchPackageNames": [
        "effect",
        "@effect/atom-react",
        "@effect/platform-node",
        "@effect/platform-node-shared"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": ["@rspress/*"],
      "groupName": "rspress"
    }
  ]
}
