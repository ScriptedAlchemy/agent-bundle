{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "repos/**"
  ],
  "packageRules": [
    {
      "description": "Keep Effect runtime upgrades in the coordinated release and subtree chore.",
      "matchPackageNames": [
        "effect",
        "@effect/atom-react",
        "@effect/platform-node",
        "@effect/platform-node-shared"
      ],
      "enabled": false
    },
    {
      "description": "Keep JavaScript compiler API consumers on TypeScript 6 until their native API integrations are migrated.",
      "matchDepNames": [
        "twoslash>typescript",
        "typedoc>typescript",
        "typescript-6"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "matchPackageNames": ["@rspress/*"],
      "groupName": "rspress"
    },
    {
      "description": "Keep the bundled JavaScript parser alias on TypeScript 5 until its compiler API is migrated.",
      "matchDepNames": ["typescript-5"],
      "allowedVersions": "<6.0.0"
    }
  ]
}
