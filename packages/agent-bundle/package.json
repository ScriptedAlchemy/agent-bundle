{
  "name": "agent-bundle",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "agent-bundle": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "import": "./dist/eval.js"
    }
  },
  "dependencies": {
    "@rstackjs/load-config": "0.1.2",
    "fast-glob": "3.3.3",
    "ignore": "7.0.6",
    "jiti": "2.7.0",
    "yaml": "2.9.0"
  }
}
