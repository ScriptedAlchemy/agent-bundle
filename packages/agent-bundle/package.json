{
  "name": "agent-bundle",
  "version": "0.1.0",
  "description": "Compile a typed Agent Bundle configuration into portable, Codex, Claude Code, and Cursor artifacts.",
  "license": "Apache-2.0",
  "keywords": [
    "agent",
    "claude-code",
    "codex",
    "mcp"
  ],
  "homepage": "https://github.com/ScriptedAlchemy/agent-bundle#readme",
  "bugs": {
    "url": "https://github.com/ScriptedAlchemy/agent-bundle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScriptedAlchemy/agent-bundle.git"
  },
  "publishConfig": {
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node ../../scripts/sync-license-files.mjs && pnpm build:workbench && rslib build",
    "build:workbench": "pnpm --filter agent-bundle-workbench build"
  },
  "files": [
    "bin",
    "dist",
    "!dist/workbench/**/*.map",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "bin": {
    "agent-bundle": "./bin/agent-bundle.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./cli-entry": {
      "types": "./dist/cli-entry.d.ts",
      "import": "./dist/cli-entry.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "import": "./dist/eval.js"
    },
    "./mcp-apps": {
      "types": "./dist/mcp-apps.d.ts",
      "import": "./dist/mcp-apps.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "import": "./dist/meta.js"
    },
    "./mcp-entry": {
      "types": "./dist/mcp-entry.d.ts",
      "import": "./dist/mcp-entry.js"
    },
    "./routes": {
      "types": "./dist/routes/public.d.ts",
      "import": "./dist/routes.js"
    },
    "./rstest": {
      "types": "./dist/rstest/index.d.ts",
      "import": "./dist/rstest.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test.js"
    },
    "./test/browser": {
      "types": "./dist/test/browser.d.ts",
      "import": "./dist/test/browser.js"
    }
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@rsbuild/core": "2.2.1",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "0.23.2",
    "@rslint/core": "0.8.2",
    "@rstackjs/load-config": "0.1.2",
    "acorn": "8.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "effect": "4.0.0-rc.112",
    "es-module-lexer": "2.3.2",
    "fast-glob": "3.3.3",
    "ignore": "7.0.7",
    "jiti": "2.7.0",
    "npm-package-arg": "13.0.2",
    "open": "11.0.2",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/npm-package-arg": "6.1.4",
    "@types/react": "19.2.18",
    "@types/ws": "8.18.1",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@e5f8d5f",
    "react": "19.2.8",
    "typescript-5": "npm:typescript@5.9.3",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@agent-bundle/runtime": "*",
    "@rstest/core": "^0.11.10",
    "react": "19.2.8"
  },
  "peerDependenciesMeta": {
    "@agent-bundle/runtime": {
      "optional": true
    },
    "@rstest/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
