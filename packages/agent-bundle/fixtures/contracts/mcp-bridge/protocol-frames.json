{
  "binding": {
    "serverName": "fixture",
    "sessionId": "selected-artifact",
    "target": "portable"
  },
  "frames": [
    {
      "direction": "browser-to-service",
      "envelope": {
        "id": 0,
        "jsonrpc": "2.0",
        "method": "initialize",
        "params": {
          "capabilities": {},
          "clientInfo": {
            "name": "bridge-contract-client",
            "version": "1.0.0"
          },
          "protocolVersion": "2025-11-25"
        }
      }
    },
    {
      "direction": "service-to-browser",
      "envelope": {
        "id": 0,
        "jsonrpc": "2.0",
        "result": {
          "capabilities": {
            "tools": {}
          },
          "protocolVersion": "2025-11-25",
          "serverInfo": {
            "name": "bridge-fixture",
            "version": "1.0.0"
          }
        }
      }
    },
    {
      "direction": "browser-to-service",
      "envelope": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      }
    },
    {
      "direction": "browser-to-service",
      "envelope": {
        "id": 1,
        "jsonrpc": "2.0",
        "method": "tools/list"
      }
    },
    {
      "direction": "service-to-browser",
      "envelope": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {
          "tools": [
            {
              "inputSchema": {
                "type": "object"
              },
              "name": "progress"
            },
            {
              "inputSchema": {
                "type": "object"
              },
              "name": "wait"
            }
          ]
        }
      }
    },
    {
      "direction": "browser-to-service",
      "envelope": {
        "id": 2,
        "jsonrpc": "2.0",
        "method": "tools/call",
        "params": {
          "arguments": {},
          "name": "progress"
        }
      }
    },
    {
      "direction": "service-to-browser",
      "envelope": {
        "jsonrpc": "2.0",
        "method": "notifications/progress",
        "params": {
          "progress": 1,
          "progressToken": "bridge-progress",
          "total": 1
        }
      }
    },
    {
      "direction": "service-to-browser",
      "envelope": {
        "id": 2,
        "jsonrpc": "2.0",
        "result": {
          "content": [
            {
              "text": "progress complete",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "direction": "browser-to-service",
      "envelope": {
        "id": 3,
        "jsonrpc": "2.0",
        "method": "tools/call",
        "params": {
          "arguments": {},
          "name": "wait"
        }
      }
    },
    {
      "direction": "browser-to-service",
      "envelope": {
        "jsonrpc": "2.0",
        "method": "notifications/cancelled",
        "params": {
          "reason": "Error: bridge cancellation probe",
          "requestId": 3
        }
      }
    },
    {
      "direction": "service-to-browser",
      "envelope": {
        "error": {
          "code": -32800,
          "message": "Cancelled by bridge fixture"
        },
        "id": 3,
        "jsonrpc": "2.0"
      }
    },
    {
      "direction": "service",
      "event": "close"
    }
  ],
  "stderr": "bridge fixture stderr\n"
}
