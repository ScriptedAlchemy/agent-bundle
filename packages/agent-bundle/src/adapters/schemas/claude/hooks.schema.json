{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bundle.dev/schemas/claude/2.1.250/hooks.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string" },
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matcher": { "type": "string" },
            "hooks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": { "type": "string", "minLength": 1 },
                  "timeout": { "type": "integer", "minimum": 1 },
                  "type": { "const": "command" }
                },
                "required": ["type", "command"]
              }
            }
          },
          "required": ["hooks"]
        }
      }
    }
  },
  "required": ["hooks"]
}
