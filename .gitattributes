# The canonical license files are verified byte-for-byte (SHA-256 against
# apache.org and root-vs-package copies), so they must never be CRLF-converted
# by core.autocrlf on checkout.
/LICENSE text eol=lf
/NOTICE text eol=lf

# Published Node executables need LF shebangs on Windows checkouts.
/packages/agent-bundle/bin/*.js text eol=lf
/packages/create-agent-bundle/bin/*.js text eol=lf
