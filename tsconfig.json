{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "exclude": [
    "repos",
    "packages/agent-bundle/src/web-host/browser/main.ts"
  ],
  "include": [
    "*.ts",
    "fixtures/**/*.ts",
    "packages/agent-bundle/fixtures/**/*.ts",
    "packages/agent-bundle/fixtures/**/*.tsx",
    "packages/agent-bundle/src/**/*.ts",
    "packages/agent-bundle/tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
